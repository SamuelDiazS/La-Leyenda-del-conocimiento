# Conexión a Base de Datos Neon PostgreSQL
# Formato: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clave secreta para firma de sesiones y tokens JWT (Mínimo 32 caracteres)
SESSION_SECRET=aethoria_secret_session_key_knowledge_legend_2026_production

# Administrador inicial del sistema
INITIAL_ADMIN_USERNAME=Fredy
INITIAL_ADMIN_PASSWORD=Admin_JL2026

# Ably Realtime para MMORPG multijugador sincronizado
# Obtén tu clave en https://ably.com/ (nivel gratuito)
ABLY_API_KEY=
NEXT_PUBLIC_ABLY_KEY=

# Configuración del servidor
NEXT_PUBLIC_APP_URL=http://localhost:3000
